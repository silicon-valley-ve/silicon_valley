<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_pos_dual_currency_config_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos_dual_currency</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_payment_section']" position="after">
                    <block title="Pantalla de doble moneda para POS" id="pos_custom_dual">
                            <setting string="Activar POS Doble Moneda" help="Activar POS Doble Moneda">
                                <field name="pos_dual_currency" />
                                <div class="content-group mt16" invisible="not pos_dual_currency">
                                    <div class="row mt16">
                                        <label for="currency_id" string="Moneda de la Empresa"  class="o_light_label"/>
                                        <field name="currency_id" readonly="1"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="pos_second_currency" string="Moneda de doble Empresa"  class="o_light_label"/>
                                        <field name="pos_second_currency"/>
                                    </div>
                                </div>
                            </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>