<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_dual_currency.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <!-- Localizamos la etiqueta donde se muestra el precio original -->
        <xpath expr="//div[hasclass('product-price')]" position="append">
            <span class="product-price-dual text-muted ms-1" t-if="props.priceDual">
                (<t t-esc="props.priceDual"/>)
            </span>
        </xpath>
    </t>

</templates>