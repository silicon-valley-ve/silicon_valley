<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_dual_currency.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-amount')][1]" position="inside">
            <t t-if="pos.config.dual_currency">
                <br/>
                <span t-esc="formatCurrencyDual(props.data.amount_total)" class="pos-receipt-right-align"/>
                <br/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('receipt-change')]" position="inside">
            <t t-if="pos.config.dual_currency">
                <br/>
                <span t-esc="formatCurrencyDual(props.data.change)" class="pos-receipt-right-align"/>
                <br/>
            </t>
        </xpath>
    </t>
</templates>