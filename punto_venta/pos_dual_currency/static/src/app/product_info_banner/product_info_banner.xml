<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_dual_currency.ProductInfoBanner" t-inherit="point_of_sale.ProductInfoBanner" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('section-product-info-title')]//div[hasclass('d-flex')]//div[2]//div[1]"
               position="inside">
           <t t-if="pos.config.dual_currency">
                / <span t-esc="getCurrencyDual(state.price_with_tax)" class="total second-currency-text"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('section-product-info-title')]//div[hasclass('d-flex')]//div[2]//div[2]" position="inside">
            <t t-if="pos.config.dual_currency">
                / <span t-esc="getCurrencyDual(state.tax_amount)" class="total second-currency-text"/>
            </t>
        </xpath>
    </t>
</templates>