<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_pos_impresora_config_form" model="ir.ui.view">
            <field name="name">view.pos.impresora.config.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_payment_section']" position="after">
                    <block title="Pantalla de configuracion Impresora Fiscal" id="pos_impresora">
                            <setting string="Serial Impresora Epson" help="Prueba">
                                <field name="serial_impresora_epson" />
                                
                            </setting>
                            <setting string="Serial Impresora Generico" help="Prueba">
                                <field name="serial_impresora" />
                            </setting>
                            <setting string="Puerto Impresora" help="Ejemplo COM7">
                                <field name="puerto_impresora" />
                            </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>