    <t t-name="pos_stocks.OutOfStockMessagePopup">
        <Dialog size="'md'" title="props.title">
            <div>
                <t t-esc="  props.body || '' " />
            </div>

            <t t-set-slot="footer">
                
                <button class="backend-button cancel button btn btn-lg btn-secondary"
                    t-on-click="props.close">
                    OK
                </button>
            </t>
        </Dialog>
    </t>
