<templates id="template" xml:space="preserve">
    <t t-name="ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="before">
            <t t-set="product" t-value="props.product"/>
            <t t-if="this.env.services.pos.config.wk_display_stock and product.type == 'consu'">
                <t t-if="product.wk_total_qty_arr?.length">
                    <t t-if="product.wk_total_qty_arr?.find(n=>n>0)">
                        <span class="qty-tag-multiple"  t-att-id="'qty-tag'+product.id">
                            <t t-foreach="product.wk_total_qty_arr" t-as="nbr" t-key="nbr_index">
                                <span t-attf-style="background: {{nbr>=0?nbr==0?'grey':'green':'red'}};
                                        padding: 6px 10px;
                                        border-radius: 5px;
                                        margin-left: 5px;">
                                    <t t-esc="nbr"/>
                                </span>
                                <t t-if="product.dot_dot and nbr_index>=2">
                                    <span style="
                                        position: absolute;
                                        width: auto;
                                        margin-left: 5px;
                                        align-content: center;
                                        color: black;
                                        font-size: 20px;
                                        font-weight: bold;
                                    ">...</span>
                                </t>
                            </t>
                        </span>
                        
                    </t>
                    
                    <t t-else="">
                        <t t-foreach="product.wk_total_qty_arr" t-as="nbr" t-key="nbr_index">
                        <span class="qty-tag" style="background: red;" t-att-id="'qty-tag'+product.id">
                                <t t-esc="nbr"/>
                            </span>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <t t-if="product.wk_qty_available > 0">
                        <span class="qty-tag" style="background: green;" t-att-id="'qty-tag'+product.id">
                            <t t-esc="product.wk_qty_available"/>
                        </span>
                    </t>
                    <t t-elif="product.wk_qty_available == 0">
                        <span class="qty-tag" style="background: gray;" t-att-id="'qty-tag'+product.id">
                            <t t-esc="product.wk_qty_available"/>
                        </span>
                    </t>
                    <t t-else="">
                        <span class="qty-tag" style="background: red;" t-att-id="'qty-tag'+product.id">
                            <t t-esc="product.wk_qty_available"/>
                        </span>
                    </t>
                </t>
            </t>
        </xpath>
    </t>
