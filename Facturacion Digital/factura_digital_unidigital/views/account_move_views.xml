                      </group>
                      <group name="studio_group_4pi_right">
                        <field name="json_enviado"/>
                      </group>
                    </group>
                  </page>
                </xpath>

                <!--xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
